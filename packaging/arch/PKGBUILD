# Replace SKIP with the SHA-256 checksum of the tagged GitHub archive before AUR submission.
pkgname=stl-viewer
pkgver=0.1.0
pkgrel=1
pkgdesc='Desktop library and previewer for STL models'
arch=('x86_64')
url='https://github.com/marcin022/arch-stl-viewer'
license=('GPL-3.0-only')
depends=('aspnet-runtime' 'python' 'python-gobject' 'gtk3' 'webkit2gtk-4.1' 'glib2')
makedepends=('dotnet-sdk')
optdepends=('zenity: graphical folder chooser outside KDE' 'kdialog: graphical folder chooser on KDE')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/arch-stl-viewer-${pkgver}"
  dotnet publish StlViewer/StlViewer.csproj --configuration Release \
    --self-contained false -p:UseAppHost=false -p:DebugType=None \
    -p:DebugSymbols=false --output "${srcdir}/publish"
}

package() {
  cd "${srcdir}/arch-stl-viewer-${pkgver}"
  install -d "${pkgdir}/usr/lib/${pkgname}"
  cp -r "${srcdir}/publish/." "${pkgdir}/usr/lib/${pkgname}/"
  install -Dm644 desktop.py "${pkgdir}/usr/lib/${pkgname}/desktop.py"
  install -Dm755 packaging/arch/stl-viewer "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 packaging/arch/stl-viewer.desktop \
    "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  install -Dm644 packaging/arch/stl-viewer.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname}.svg"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
